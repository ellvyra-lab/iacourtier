# Copy values into .env.local or Vercel environment settings; never commit secrets.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=

# Exact origin, no trailing path. Production: https://iacourtier.ca
CONNECTIONS_APP_URL=http://localhost:3100
# 32 random bytes encoded in base64. Server only. Keep stable across deployments.
CONNECTIONS_ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# common permits the personal and organizational account types enabled in Entra.
MICROSOFT_TENANT_ID=common
