# Copy this file to .env.local and fill in your real values.
# .env.local is git-ignored and never committed.

# ---- MailerLite (newsletter / guide download capture) ----
# https://dashboard.mailerlite.com/integrations/api
MAILERLITE_API_KEY=
MAILERLITE_GROUP_ID=

# ---- Supabase (auth, database, history) ----
# https://supabase.com/dashboard -> your project -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Settings -> API -> "service_role" key. SERVER-ONLY — never expose this
# to the browser. Used only by the Stripe webhook to update profiles
# without a logged-in user session.
SUPABASE_SERVICE_ROLE_KEY=

# ---- OpenAI (powers every Assistant IA) ----
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_DOCUMENT_MODEL=gpt-4o

# ---- Stripe (subscriptions) ----
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
# https://dashboard.stripe.com/webhooks -> add endpoint -> signing secret
STRIPE_WEBHOOK_SECRET=
# https://dashboard.stripe.com/products -> create a recurring price for
# each paid plan, then paste the Price IDs (start with "price_") here.
STRIPE_PRICE_ESSENTIEL=
STRIPE_PRICE_PRO=

# ---- Sentry (error monitoring) ----
# https://sentry.io -> create a Next.js project -> Settings -> Client Keys (DSN)
NEXT_PUBLIC_SENTRY_DSN=
# Only needed for source map upload in CI/production builds — optional.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ---- Birthday email automation (server-only) ----
# Use "dry-run" until the single-address test succeeds; switch to "live" for real delivery.
EMAIL_DELIVERY_MODE=dry-run
# Transactional email endpoint. The default implementation supports the Resend-compatible API.
EMAIL_API_URL=https://api.resend.com/emails
EMAIL_API_KEY=
EMAIL_FROM="Sonia <anniversaires@votre-domaine.ca>"
# Mandatory allow-list for the test button. Tests can only be sent to this exact address.
BIRTHDAY_TEST_EMAIL=
# Long random value. Vercel sends it as Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=
